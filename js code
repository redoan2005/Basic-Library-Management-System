let books = [
    {
        name: "Python Basics",
        writer: "Reza",
        qty: 5
    },
    {
        name: "JS Guide",
        writer: "Karim",
        qty: 2
    }
];

function displayBooks(){

    let bookList =
    document.getElementById("book-list");

    bookList.innerHTML = "";

    for(let book of books){

        bookList.innerHTML += `
        <div class="book-card">
            <h3>${book.name}</h3>

            <p>Writer:
            ${book.writer}</p>

            <p>Quantity:
            ${book.qty}</p>

            <button onclick="borrowBook(${books.indexOf(book)})">
                Borrow
            </button>

            <button onclick="returnBook(${books.indexOf(book)})">
                Return
            </button>
                
        </div>
        `;
    }
}

displayBooks();

let addBtn =
document.getElementById("addBtn");

addBtn.addEventListener(
    "click",
    addBook
);

function addBook(){

    let name =
    document.getElementById(
        "bookName"
    ).value;

    let writer =
    document.getElementById(
        "writerName"
    ).value;

    let qty =
    document.getElementById(
        "quantity"
    ).value;

    if(
        name=="" ||
        writer=="" ||
        qty==""
    ){
        alert("Fill all fields!");
        return;
    }

    let newBook = {
        name:name,
        writer:writer,
        qty:Number(qty)
    };

    books.push(newBook);

    displayBooks();
}

function borrowBook(index){

    if(books[index].qty > 0){
        books[index].qty--;
        displayBooks();
    }

    else{
        alert("Book not available!");
    }
}

function returnBook(index){
    books[index].qty++;
    displayBooks();
}
